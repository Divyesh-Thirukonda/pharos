# Server-side settings only. Leave blank for honest disconnected provider states.
# Do not put secrets into VITE_ variables or commit a populated .env file.
VSS_URL=
VSS_USERNAME=
VSS_PASSWORD=
WANDB_API_KEY=
WANDB_TEAM=
WANDB_PROJECT=pharos
# Optional: otherwise discover a currently available text model from the provider.
WANDB_MODEL=

# Direct inference on actual captured video; all values remain server-side.
COSMOS3_REASON_URL=
# Leave unset to discover the actual served model ID from /v1/models.
COSMOS3_REASON_MODEL=
YOLO_URL=
GPU_BEARER_TOKEN=

# Optional inference traces: install backend/requirements-tracing.txt, then set
# WEAVE_PROJECT to your team/project. Traces include supplied evidence and results.
WEAVE_PROJECT=
WEAVE_ENABLED=false

# Optional public-data token and cache path; no credentials needed for public reads.
SOCRATA_APP_TOKEN=
# PHAROS_CACHE_DIR=/absolute/path/to/public-cache
